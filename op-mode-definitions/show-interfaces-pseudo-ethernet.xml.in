<?xml version="1.0"?>
<interfaceDefinition>
  <node name="show">
    <children>
      <node name="interfaces">
        <children>
          <tagNode name="pseudo-ethernet">
            <properties>
              <help>Show specified Pseudo-Ethernet/MACvlan interface information</help>
              <completionHelp>
                <path>interfaces pseudo-ethernet</path>
              </completionHelp>
            </properties>
            <command>${vyos_op_scripts_dir}/interfaces.py show --intf-name="$4" --intf-type=pseudo-ethernet</command>
            <children>
              <node name="brief">
                <properties>
                  <help>Show summary of the specified pseudo-ethernet/MACvlan interface information</help>
                </properties>
                <command>${vyos_op_scripts_dir}/interfaces.py show_summary --intf-name="$4" --intf-type=pseudo-ethernet</command>
                <children>
                  <leafNode name="json">
                    <properties>
                      <help>Show JSON structured summary of the specified pseudo-ethernet/MACvlan interface</help>
                    </properties>
                    <command>${vyos_op_scripts_dir}/interfaces.py show_summary --intf-name="$4" --intf-type=pseudo-ethernet --raw</command>
                  </leafNode>
                </children>
              </node>
              <leafNode name="json">
                <properties>
                  <help>Show JSON structured detailed information of the specified pseudo-ethernet/MACvlan interface</help>
                </properties>
                <command>${vyos_op_scripts_dir}/interfaces.py show --intf-name="$4" --intf-type=pseudo-ethernet --raw</command>
              </leafNode>
              #include <include/show-interface-type-event-log.xml.i>
            </children>
          </tagNode>
          <node name="pseudo-ethernet">
            <properties>
              <help>Show Pseudo-Ethernet/MACvlan interface information</help>
            </properties>
            <command>${vyos_op_scripts_dir}/interfaces.py show_summary --intf-type=pseudo-ethernet</command>
            <children>
              <node name="detail">
                <properties>
                  <help>Show detailed pseudo-ethernet/MACvlan interface information</help>
                </properties>
                <command>${vyos_op_scripts_dir}/interfaces.py show --intf-type=pseudo-ethernet</command>
                <children>
                  <leafNode name="json">
                    <properties>
                      <help>Show JSON structured detailed information of all pseudo-ethernet/MACvlan interfaces</help>
                    </properties>
                    <command>${vyos_op_scripts_dir}/interfaces.py show --intf-type=pseudo-ethernet --raw</command>
                  </leafNode>
                </children>
              </node>
              <leafNode name="json">
                <properties>
                  <help>Show JSON structured information of all pseudo-ethernet/MACvlan interfaces</help>
                </properties>
                <command>${vyos_op_scripts_dir}/interfaces.py show_summary --intf-type=pseudo-ethernet --raw</command>
              </leafNode>
            </children>
          </node>
        </children>
      </node>
    </children>
  </node>
</interfaceDefinition>
