<?xml version="1.0"?>
<interfaceDefinition>
  <node name="show">
    <children>
      <node name="interfaces">
        <children>
          <tagNode name="bridge">
            <properties>
              <help>Show specified Bridge interface information</help>
              <completionHelp>
                <path>interfaces bridge</path>
              </completionHelp>
            </properties>
            <command>${vyos_op_scripts_dir}/interfaces.py show --intf-name="$4" --intf-type=bridge</command>
            <children>
              <node name="brief">
                <properties>
                  <help>Show summary of the specified bridge interface information</help>
                </properties>
                <command>${vyos_op_scripts_dir}/interfaces.py show_summary --intf-name="$4" --intf-type=bridge</command>
                <children>
                  <leafNode name="json">
                    <properties>
                      <help>Show JSON structured summary information of the specified bridge interface</help>
                    </properties>
                    <command>${vyos_op_scripts_dir}/interfaces.py show_summary --intf-name="$4" --intf-type=bridge --raw</command>
                  </leafNode>
                </children>
              </node>
              <leafNode name="json">
                <properties>
                  <help>Show JSON structured information of the specified bridge interface</help>
                </properties>
                <command>${vyos_op_scripts_dir}/interfaces.py show --intf-name="$4" --intf-type=bridge --raw</command>
              </leafNode>
              #include <include/show-interface-type-event-log.xml.i>
            </children>
          </tagNode>
          <node name="bridge">
            <properties>
              <help>Show Bridge interface information</help>
            </properties>
            <command>${vyos_op_scripts_dir}/interfaces.py show_summary --intf-type=bridge</command>
            <children>
              <node name="detail">
                <properties>
                  <help>Show detailed bridge interface information</help>
                </properties>
                <command>${vyos_op_scripts_dir}/interfaces.py show --intf-type=bridge</command>
                <children>
                  <leafNode name="json">
                    <properties>
                      <help>Show JSON structured detail information of all bridge interfaces</help>
                    </properties>
                    <command>${vyos_op_scripts_dir}/interfaces.py show --intf-type=bridge --raw</command>
                  </leafNode>
                </children>
              </node>
              <leafNode name="json">
                <properties>
                  <help>Show JSON structured information of all bridge interfaces</help>
                </properties>
                <command>${vyos_op_scripts_dir}/interfaces.py show_summary --intf-type=bridge --raw</command>
              </leafNode>
            </children>
          </node>
        </children>
      </node>
    </children>
  </node>
</interfaceDefinition>
